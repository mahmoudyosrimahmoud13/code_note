# Copy this file to .env and fill it in.

# The name the app shows when someone types this server's address.
SERVER_NAME=CodeNote server

# A long random value. Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The address people type in the app, for example https://chat.example.com
# (used for picture links). Leave empty to use the address of each request.
PUBLIC_URL=

# Database password for docker compose (any long random text).
DB_PASSWORD=change-this-database-password

# Only needed without docker compose (compose sets it for you):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/codenote

# Google sign-in: your OAuth client ids, comma separated (Web client id and Android client id).
GOOGLE_CLIENT_IDS=

# Push notifications: path to the Firebase service account JSON inside the container,
# for example /data/firebase.json (put the file in the "data" volume).
FCM_SERVICE_ACCOUNT_FILE=

# Email codes (verification and password reset). Without this the codes go to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=false

# More admins by email, comma separated. The first account is always an admin.
ADMIN_EMAILS=
